# Public site URL used for metadata, sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=https://www.tawaafresh.co.uk

# Required for the enquiry and quote forms to send real email. Every
# submission is emailed to info@tawaafresh.com (see src/lib/site-config.ts)
# and the customer receives an automatic acknowledgement from this same
# mailbox. Without these set, submissions are logged server-side instead of
# emailed — the forms still work end-to-end for local development.
#
# If your mailbox is hosted with Fasthosts, these are typically:
#   SMTP_HOST=mail.tawaafresh.com
#   SMTP_PORT=465
# (confirm the exact host/port with Fasthosts for your mailbox.)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@tawaafresh.com
SMTP_PASS=

# Optional: only needed if you swap the static map placeholder on the
# Contact page for a live Google Maps embed (see MapPlaceholder.tsx).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
